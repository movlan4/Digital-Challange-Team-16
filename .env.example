# Copy to .env (used by docker compose and run-local.ps1). Change these before any real deployment.

# Master admin account - seeded at start-up, signs in on the same login screen as everyone else
ADMIN_EMAIL=admin@transit.az
ADMIN_PASSWORD=Operator-Baku-2026

# Demo passenger account used during development / judging.
# Passengers self-register on the login page; this is just a suggested test login.
DEMO_PASSENGER_EMAIL=demo.passenger@example.com
DEMO_PASSENGER_PASSWORD=Passenger-Demo-2026

# Outgoing mail for "Forgot password" codes. Leave SMTP_HOST empty to print codes to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=Baku Smart Transit <no-reply@transit.az>

# Report consensus: a bus's status only changes once this many different passengers reported it (15-min window)
REPORT_CONSENSUS_MIN_REPORTERS=3

# Set to true when served over HTTPS
SECURE_COOKIES=false

# GPS simulator rush-hour demand & traffic: auto (Baku 07:30-09:30 / 17:30-19:30 on weekdays) | always | never
# Use "always" to demo peak-hour crowding at any time of day.
SIM_RUSH_HOUR=auto
